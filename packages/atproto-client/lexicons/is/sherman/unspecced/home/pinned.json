{
  "lexicon": 1,
  "id": "is.sherman.unspecced.home.pinned",
  "defs": {
    "main": {
      "type": "record",
      "description": "What my homepage pins, in order. Pins are read from their records, not the activity feed, so they can be of any age.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["items", "updatedAt"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "type": "ref", "ref": "#item" },
            "maxLength": 20
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "What's pinned: a site.standard.document, a blog post or a thread. Not a strong ref, so the pin follows the record's edits."
        },
        "hero": {
          "type": "boolean",
          "default": false,
          "description": "Shown as a card. Otherwise it's listed under the cards."
        }
      }
    }
  }
}
