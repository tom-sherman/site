{
  "name": "@repo/atproto-client",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.js"
    },
    "./effect": {
      "types": "./src/effect.ts",
      "default": "./src/effect.js"
    }
  },
  "scripts": {
    "build": "lex build --clear && tsc",
    "lex:install": "lex install",
    "check-types": "tsc --noEmit",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@atproto/lex": "catalog:",
    "@repo/lint": "workspace:*",
    "@types/node": "^26.6.5",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@atproto/lex": "catalog:",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
