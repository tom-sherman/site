# Defaults for `next dev`. Not secret. Override in .env.local (gitignored).

# Must match the activity cache's OIDC_ISSUER exactly, with no trailing slash.
OIDC_ISSUER=http://localhost:3000
# Unset, so `next dev` signs with a key it generates on startup.
# OIDC_SIGNING_KEYS=

ACTIVITY_CACHE_URL=http://localhost:3001
ACTIVITY_CACHE_AUDIENCE=activity-cache
